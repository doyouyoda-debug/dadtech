{
  "name": "dadtech",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./src/styles.css -o ./dist/styles.css --minify",
    "dev:css": "tailwindcss -i ./src/styles.css -o ./dist/styles.css --watch",
    "build:game": "tailwindcss -i ./monsterOpera/style.css -o ./monsterOpera/style.min.css",
    "watch:game": "tailwindcss -i ./monsterOpera/style.css -o ./monsterOpera/style.min.css --watch",
    "serve": "live-server --port=3000 --open=./index.html --quiet",
    "dev": "concurrently \"npm run dev:css\" \"npm run serve\""
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "live-server": "^1.2.2",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.4.14"
  }
}
